<Window
    x:Class="EditorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JSON エディタ">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" />

        <Grid x:Name="AppContent" Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12"
                        Margin="0,0,0,12">
                <Button x:Name="ResetButton" Content="サンプルに戻す" Click="OnReset" IsEnabled="False" />
                <ToggleButton x:Name="ReadOnlyButton" Content="読み取り専用"
                              Click="OnReadOnlyChanged" IsEnabled="False" />
            </StackPanel>
            <WebView2 x:Name="EditorView" Grid.Row="1" Loaded="OnEditorLoaded"
                      AutomationProperties.Name="JSON エディタ" />
        </Grid>

        <Border Grid.Row="2" MinHeight="32" Padding="24,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="StatusText"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
