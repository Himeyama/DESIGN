<Window
    x:Class="WebViewApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebView サンプル">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" />

        <Grid x:Name="AppContent" Grid.Row="1" Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button x:Name="ReloadButton" Content="再読み込み"
                        Click="OnReload" IsEnabled="False" />
                <TextBlock Text="https://example.com/" VerticalAlignment="Center" />
            </StackPanel>
            <WebView2 x:Name="Browser" Grid.Row="1" Loaded="OnBrowserLoaded"
                      AutomationProperties.Name="Example Domain" />
        </Grid>

        <Border Grid.Row="2" MinHeight="32" Padding="24,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="StatusText"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
